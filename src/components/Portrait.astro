---
/**
 * Fotografía de Victor.
 * Para usar una foto real basta con añadir `src/assets/victor/<variant>.jpg`
 * (o .png/.webp/.avif). Mientras no exista, se muestra un placeholder
 * claramente identificado (brief §21).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  variant: 'hero' | 'about' | 'cta';
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { variant, sizes = '(min-width: 960px) 40vw, 100vw', eager = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/victor/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const match = Object.entries(files).find(([path]) => path.split('/').pop()?.startsWith(`${variant}.`));
const image = match?.[1].default;

const hints: Record<Props['variant'], string> = {
  hero: 'Retrato vertical, mirada a cámara, fondo neutro',
  about: 'Trabajando: con cliente, pizarra o pantalla',
  cta: 'Retrato cercano, expresión abierta',
};
---

<figure class:list={['portrait', `portrait--${variant}`, className]}>
  {
    image ? (
      <Image
        src={image}
        alt="Victor Chifoni, Growth Partner"
        widths={[480, 720, 960, 1280]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="portrait__img"
      />
    ) : (
      <div class="portrait__placeholder" role="img" aria-label="Espacio reservado para la fotografía de Victor Chifoni">
        <svg class="portrait__grid" viewBox="0 0 300 400" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <pattern id={`g-${variant}`} width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.5" />
            </pattern>
          </defs>
          <rect width="300" height="400" fill={`url(#g-${variant})`} />
          <circle cx="150" cy="150" r="58" fill="none" stroke="currentColor" stroke-width="1" />
          <path d="M52 400c8-80 50-128 98-128s90 48 98 128" fill="none" stroke="currentColor" stroke-width="1" />
        </svg>
        <span class="portrait__mono" aria-hidden="true">VC</span>
        <span class="portrait__note">
          <span class="pending">Foto de Victor</span>
          <span class="portrait__hint mono">{hints[variant]}</span>
        </span>
      </div>
    )
  }
  <slot />
</figure>

<style>
  .portrait {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-3);
    aspect-ratio: 4 / 5;
  }

  .portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--paper-2);
    color: color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .portrait__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .portrait__mono {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) 12%, transparent);
    letter-spacing: -0.05em;
    transform: translateY(-18%);
  }

  .portrait__note {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 1rem;
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .portrait__hint {
    font-size: 0.68rem;
    color: var(--graphite);
    text-transform: none;
  }
</style>
