---
import { publishedCases } from '../../data/cases';
import Icon from '../Icon.astro';
import Counter from '../Counter.astro';
import BrandLogo from '../BrandLogo.astro';
import { brandForCase } from '../../data/brands';

const cases = publishedCases().slice(0, 3);
---

<section class="proof section--tight" id="resultados" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="proof__head">
      <h2 id="proof-title" class="label muted">Resultados de proyectos en los que he trabajado</h2>
      <a href="/casos" class="link mono">Todos los casos <Icon name="arrow" size={14} /></a>
    </div>
    <ul role="list" class="proof__grid">
      {
        cases.map((c, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={`/casos/${c.slug}`} class="proof__item">
              <span class="proof__metric">
                {c.metric.value !== undefined ? (
                  <Counter value={c.metric.value} prefix={c.metric.prefix} suffix={c.metric.suffix} />
                ) : (
                  c.metric.display
                )}
              </span>
              <span class="proof__label">{c.metric.label}</span>
              <span class="proof__client">
                {brandForCase(c.slug) && <BrandLogo brand={brandForCase(c.slug)!} size="sm" fallback={false} />}
                <span>{c.client}</span>
                <span class="mono muted">{c.sector}</span>
              </span>
              <span class="proof__go" aria-hidden="true">
                <Icon name="arrow-up-right" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .proof__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .proof__head .link {
    white-space: nowrap;
  }

  .proof__head h2 {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .proof__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 820px) {
    .proof__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .proof__grid > li {
    background: var(--paper);
  }

  .proof__item {
    position: relative;
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    text-decoration: none;
    transition: background-color 0.4s;
  }

  .proof__item:hover {
    background: var(--paper-2);
  }

  .proof__metric {
    font-size: var(--step-4);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .proof__label {
    color: var(--graphite);
    max-width: 26ch;
  }

  .proof__client {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-weight: 540;
  }

  .proof__client .mono {
    font-size: 0.7rem;
  }

  .proof__go {
    position: absolute;
    top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    right: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition:
      background-color 0.3s,
      transform 0.5s var(--ease-out),
      border-color 0.3s;
  }

  .proof__item:hover .proof__go {
    background: var(--signal);
    border-color: var(--signal);
    transform: rotate(45deg);
    color: var(--on-signal);
  }
</style>
