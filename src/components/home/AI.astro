---
import AIWorkflow from '../AIWorkflow.astro';
import Icon from '../Icon.astro';

const uses = [
  { t: 'Clasificación de leads', d: 'Cada oportunidad llega al comercial priorizada y con contexto.' },
  { t: 'Atención automatizada', d: 'Respuestas inmediatas a las preguntas repetidas, con traspaso a una persona cuando importa.' },
  { t: 'Informes automáticos', d: 'Los números que dirección necesita, cada semana, sin que nadie los monte a mano.' },
  { t: 'Conexión entre herramientas', d: 'Ads, web, CRM, ERP y email hablando entre sí mediante APIs y workflows.' },
  { t: 'Procesamiento de información', d: 'Catálogos, documentos, pedidos o fichas procesados en minutos, no en días.' },
  { t: 'Sistemas internos a medida', d: 'Pequeñas herramientas que eliminan justo la tarea que frena a tu equipo.' },
];
---

<section class="ai section dark" aria-labelledby="ai-title">
  <div class="wrap">
    <div class="section-head__meta ai__meta">
      <span class="eyebrow">IA y automatización</span>
      <span class="mono muted">Operación, no generación de textos</span>
    </div>

    <div class="ai__grid">
      <div class="ai__copy">
        <h2 id="ai-title" data-reveal>
          El marketing trae oportunidades. Los sistemas hacen que puedas <em class="human">aprovecharlas.</em>
        </h2>
        <p class="lead" data-reveal style="--i:1">
          No uso la IA solo para escribir textos. La uso para que tu empresa opere mejor: menos trabajo manual, respuestas
          más rápidas y datos donde se toman las decisiones.
        </p>
        <a href="/ia-automatizacion" class="btn btn--signal" data-reveal style="--i:2">
          Cómo aplico IA en empresas
          <span class="btn__arrow"><Icon name="arrow" size={14} /></span>
        </a>
      </div>
      <div class="ai__viz" data-reveal style="--i:1">
        <AIWorkflow />
      </div>
    </div>

    <ul role="list" class="ai__uses">
      {
        uses.map((u, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <span class="mono signal">{String(i + 1).padStart(2, '0')}</span>
            <h3>{u.t}</h3>
            <p class="muted">{u.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ai__meta {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .ai__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .ai__grid {
      grid-template-columns: 1fr 1.1fr;
    }

    .ai__copy {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .ai__grid > * {
    min-width: 0;
  }

  .ai__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .ai__copy h2 {
    font-size: var(--step-4);
  }

  .ai__uses {
    display: grid;
    gap: 1px;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--line-inv);
    border: 1px solid var(--line-inv);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ai__uses {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .ai__uses {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ai__uses li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--ink);
    transition: background-color 0.3s;
  }

  .ai__uses li:hover {
    background: var(--ink-2);
  }

  .ai__uses .mono {
    font-size: 0.7rem;
  }

  .ai__uses h3 {
    font-size: var(--step-1);
  }

  .ai__uses p {
    font-size: 0.9375rem;
  }
</style>
