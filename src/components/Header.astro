---
import { CTA, NAV, SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header" data-header data-tone={tone}>
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name}, inicio`}>
      <span class="brand__mark" aria-hidden="true">VC</span>
      <span class="brand__name">Victor Chifoni</span>
      <span class="brand__role mono" aria-hidden="true">Growth Partner</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn btn--signal site-header__cta">
      {CTA.primary}
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="visually-hidden" data-menu-label>Abrir menú</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu dark" id="mobile-menu" data-menu hidden>
    <div class="wrap mobile-menu__inner">
      <nav aria-label="Móvil">
        <ol role="list" class="mobile-menu__list">
          {
            [{ href: '/', label: 'Inicio' }, ...NAV, { href: '/contacto', label: 'Contacto' }].map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={item.href} aria-current={(item.href === '/' ? current === '/' : isCurrent(item.href)) ? 'page' : undefined}>
                  <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="mobile-menu__foot">
        <a href="/contacto" class="btn btn--signal">
          {CTA.primary}
          <span class="btn__arrow"><Icon name="arrow" size={14} /></span>
        </a>
        <a href={SITE.linkedin} class="link" rel="me noopener" target="_blank">
          <Icon name="linkedin" size={18} /> LinkedIn
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      background-color 0.4s,
      box-shadow 0.4s,
      transform 0.5s var(--ease-out);
  }

  .site-header[data-tone='dark']:not(.is-scrolled):not(.is-open) {
    color: var(--paper);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  .site-header.is-hidden:not(.is-open) {
    transform: translateY(-100%);
  }

  .site-header.is-open {
    color: var(--paper);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-weight: 560;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0;
    transition: background-color 0.3s;
  }

  .brand:hover .brand__mark {
    background: var(--signal);
    color: var(--ink);
  }

  .site-header[data-tone='dark']:not(.is-scrolled) .brand__mark,
  .site-header.is-open .brand__mark {
    background: var(--paper);
    color: var(--ink);
  }

  .brand__role {
    color: var(--graphite);
    padding-left: 0.7rem;
    border-left: 1px solid var(--line);
    font-size: 0.7rem;
  }

  .site-header[data-tone='dark']:not(.is-scrolled) .brand__role,
  .site-header.is-open .brand__role {
    color: var(--graphite-inv);
    border-color: var(--line-inv);
  }

  .site-nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .site-nav a {
    display: inline-block;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 480;
    transition: background-color 0.25s;
  }

  .site-nav a:hover {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .site-nav a[aria-current='page'] {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .site-header__cta {
    min-height: 2.6rem;
    padding: 0 1.1rem;
    font-size: 0.9375rem;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    place-items: center;
  }

  .menu-toggle__bars {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .menu-toggle__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.45s var(--ease-out);
  }

  .is-open .menu-toggle__bars span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .is-open .menu-toggle__bars span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 1099px) {
    .site-nav {
      display: none;
    }
  }

  @media (max-width: 1099px) and (min-width: 640px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  @media (max-width: 1099px) {
    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 639px) {
    .site-header__cta,
    .brand__role {
      display: none;
    }
  }

  /* Menú móvil */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-out);
  }

  .mobile-menu:not([hidden]) {
    display: block;
  }

  .is-open .mobile-menu {
    clip-path: inset(0 0 0 0);
  }

  .mobile-menu__inner {
    min-height: calc(100dvh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding-block: 2rem 2.5rem;
  }

  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line-inv);
    font-size: clamp(1.9rem, 7.5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-decoration: none;
  }

  .mobile-menu__list a .mono {
    color: var(--graphite-inv);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .mobile-menu__list a[aria-current='page'] {
    color: var(--signal);
  }

  .mobile-menu__list li {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 40ms + 150ms);
  }

  .is-open .mobile-menu__list li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
</style>
