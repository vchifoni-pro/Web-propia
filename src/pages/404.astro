---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/casos', label: 'Casos de crecimiento' },
  { href: '/capacidades', label: 'Capacidades' },
  { href: '/ia-automatizacion', label: 'IA y automatización' },
  { href: '/contacto', label: 'Contacto' },
];
---

<Base title="Página no encontrada" noindex>
  <section class="section nf">
    <div class="wrap nf__inner">
      <p class="mono nf__code" aria-hidden="true">404 · conversión perdida</p>
      <h1>Esta página no existe. <em class="human">Tu oportunidad sí.</em></h1>
      <p class="lead">
        Puede que el enlace haya cambiado. Mientras lo arreglo, esto es probablemente lo que buscabas:
      </p>
      <ul role="list" class="nf__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label}
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf__inner {
    display: grid;
    gap: 1.75rem;
    min-height: 60vh;
    align-content: center;
  }

  .nf__code {
    font-size: 0.75rem;
    color: var(--signal-ink);
  }

  .nf h1 {
    font-size: var(--step-5);
    max-width: 15ch;
  }

  .nf h1 .human {
    color: var(--signal-ink);
  }

  .nf__links {
    max-width: 640px;
    border-top: 1px solid var(--line);
  }

  .nf__links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.2s,
      padding 0.4s var(--ease-out);
  }

  .nf__links a:hover {
    color: var(--signal-ink);
    padding-left: 0.5rem;
  }
</style>
